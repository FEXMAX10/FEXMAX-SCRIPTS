local function findGameLabels()
    local pGui = player:FindFirstChild("PlayerGui")
    if not pGui then return end
    
    -- Buscar TextLabels
    pcall(function()
        for _, screenGui in ipairs(pGui:GetChildren()) do
            if screenGui:IsA("ScreenGui") then
                for _, obj in ipairs(screenGui:GetDescendants()) do
                    if obj:IsA("TextLabel") then
                        local text = obj.Text or ""
                        
                        -- TextLabel de cebollas
                        if string.find(obj:GetFullName(), "Onions.Onions") then
                            gameOnionLabel = obj
                            print("[ FEXMAX] GUI Cebollas:", obj:GetFullName())
                        end
                        
                        -- TextLabel del dinero principal
                        if string.find(text, "^%$") and not string.find(text, "R%$") and not moneyLabel then
                            moneyLabel = obj
                            print("[ FEXMAX] GUI Dinero:", obj:GetFullName(), "| Texto:", text)
                        end
                        
                        -- TextLabel del multiplicador
                        local lower = string.lower(text)
                        if string.find(lower, "x") and (string.find(lower, "multiplicador") or string.find(lower, "multiplier")) then
                            if not multiplierLabel then
                                multiplierLabel = obj
                                print("[ FEXMAX] Multiplicador:", obj:GetFullName())
                            end
                        end
                    end
                end
            end
        end
    end)
    
    -- ==========================================
    -- BUSCAR VALUE REAL DEL DINERO
    -- ==========================================
    local moneyKeywords = {"money", "cash", "dinero", "coins", "oro", "gold", "robux", "r$"}
    
    -- En leaderstats
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        for _, obj in ipairs(ls:GetChildren()) do
            if obj:IsA("IntValue") or obj:IsA("NumberValue") then
                local name = string.lower(obj.Name)
                for _, kw in ipairs(moneyKeywords) do
                    if string.find(name, kw) then
                        moneyValue = obj
                        print("[✅ FEXMAX] MONEY VALUE REAL:", obj:GetFullName(), "| Valor:", obj.Value)
                        break
                    end
                end
            end
        end
    end
    
    -- En el jugador directamente
    for _, obj in ipairs(player:GetChildren()) do
        if obj:IsA("IntValue") or obj:IsA("NumberValue") then
            local name = string.lower(obj.Name)
            for _, kw in ipairs(moneyKeywords) do
                if string.find(name, kw) then
                    moneyValue = obj
                    print("[✅ FEXMAX] MONEY VALUE en Player:", obj:GetFullName(), "| Valor:", obj.Value)
                    break
                end
            end
        end
    end
    
    -- En PlayerGui (buscar Values)
    if pGui then
        pcall(function()
            for _, obj in ipairs(pGui:GetDescendants()) do
                if obj:IsA("IntValue") or obj:IsA("NumberValue") then
                    local name = string.lower(obj.Name)
                    for _, kw in ipairs(moneyKeywords) do
                        if string.find(name, kw) then
                            moneyValue = obj
                            print("[✅ FEXMAX] MONEY VALUE en GUI:", obj:GetFullName(), "| Valor:", obj.Value)
                            break
                        end
                    end
                end
            end
        end)
    end
end

