    StatusLabel.BackgroundTransparency = 1
    StatusLabel.Text = "Estado: 🟢 ACTIVO"
    StatusLabel.TextColor3 = Color3.fromRGB(76, 175, 80)
    StatusLabel.Font = Enum.Font.Gotham
    StatusLabel.TextSize = 12
    StatusLabel.TextXAlignment = Enum.TextXAlignment.Left
    StatusLabel.Parent = Frame

    -- Label: Progreso de Puertas
    local DoorProgressLabel = Instance.new("TextLabel")
    DoorProgressLabel.Name = "DoorProgress"
    DoorProgressLabel.Size = UDim2.new(1, -20, 0, 22)
    DoorProgressLabel.Position = UDim2.new(0, 10, 0, 115)
    DoorProgressLabel.BackgroundTransparency = 1
    DoorProgressLabel.Text = "Puertas Desbloqueadas: 0/?"
    DoorProgressLabel.TextColor3 = Color3.fromRGB(255, 165, 0)
    DoorProgressLabel.Font = Enum.Font.Gotham
    DoorProgressLabel.TextSize = 12
    DoorProgressLabel.TextXAlignment = Enum.TextXAlignment.Left
    DoorProgressLabel.Parent = Frame

    return OnionLabel, TimeLabel, StatusLabel, DoorProgressLabel
end

local TotalLbl, TimeLbl, StatusLbl, DoorProgLbl = CreateResultsGUI()

-- ==========================================
-- 4. LÓGICA PRINCIPAL DE AUTOMATIZACIÓN
-- ==========================================
RunService.Heartbeat:Connect(function()
    local now = tick()
    
    -- Actualizar tiempo siempre
    local elapsed = math.floor(now - Stats.StartTime)
    TimeLbl.Text = string.format("Tiempo Activo: %dm %ds", math.floor(elapsed / 60), elapsed % 60)
    
    -- Dar cebolla cada intervalo
    if now - Stats.LastUpdate >= ONION_INTERVAL then
        Stats.OnionsCollected += 1
        Stats.LastUpdate = now
        
        -- 1. Actualizar nuestra GUI de resultados
        TotalLbl.Text = string.format("Cebollas Totales: %d", Stats.OnionsCollected)
        
        -- Animación flash en el contador
        local flash = TweenService:Create(TotalLbl, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextColor3 = Color3.fromRGB(76, 175, 80)})
        flash:Play()
        task.delay(0.15, function()
            TweenService:Create(TotalLbl, TweenInfo.new(0.3), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        end)
        
        -- 2. Actualizar la GUI NATIVA del juego (si se encontró)
        if playerOnionLabel then
            playerOnionLabel.Text = tostring(Stats.OnionsCollected)
        end
        
        -- 3. Actualizar contadores de puertas (simulación visual)
        local unlockedCount = 0
        for _, doorData in ipairs(doorLabels) do
            -- Simular que cada puerta necesita X cebollas (ej: 10, 20, 30...)
            -- Esto es una suposición basada en nombres como "2", "5", "10", "15"
            local required = tonumber(doorData.folder.Name) or 999
            if Stats.OnionsCollected >= required then
                doorData.label.Text = "✓" -- O el texto que use el juego para "desbloqueado"
                doorData.label.TextColor3 = Color3.fromRGB(0, 255, 0)
                unlockedCount += 1
            else
                doorData.label.Text = tostring(required - Stats.OnionsCollected)
                doorData.label.TextColor3 = Color3.fromRGB(255, 255, 255)
            end
        end
        DoorProgLbl.Text = string.format("Puertas Desbloqueadas: %d/%d", unlockedCount, #doorLabels)
    end
end)

print("[🧅 FOX] Ultimate Onion Automator cargado y listo.")
