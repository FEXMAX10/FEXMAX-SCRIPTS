    ScreenGui.Name = "FOX_UltimateOnionHUD"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    pcall(function() ScreenGui.Parent = game.CoreGui end)
    if not ScreenGui.Parent then ScreenGui.Parent = player:WaitForChild("PlayerGui") end

    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(0, 240, 0, 160)
    Frame.Position = UDim2.new(0, 15, 0.5, -80)
    Frame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    Frame.BorderSizePixel = 0
    Frame.Parent = ScreenGui
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 10)
    
    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Color3.fromRGB(76, 175, 80)
    Stroke.Thickness = 1.5
    Stroke.Parent = Frame

    -- Título
    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, 0, 0, 30)
    Title.BackgroundTransparency = 1
    Title.Text = "🧅 SHREK LINE AUTOMATOR"
    Title.TextColor3 = Color3.fromRGB(76, 175, 80)
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 13
    Title.Parent = Frame

    -- Label: Cebollas Totales
    local OnionLabel = Instance.new("TextLabel")
    OnionLabel.Name = "TotalOnions"
    OnionLabel.Size = UDim2.new(1, -20, 0, 28)
    OnionLabel.Position = UDim2.new(0, 10, 0, 35)
    OnionLabel.BackgroundTransparency = 1
    OnionLabel.Text = "Cebollas Totales: 0"
    OnionLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    OnionLabel.Font = Enum.Font.GothamMedium
    OnionLabel.TextSize = 16
    OnionLabel.TextXAlignment = Enum.TextXAlignment.Left
    OnionLabel.Parent = Frame

    -- Label: Tiempo
    local TimeLabel = Instance.new("TextLabel")
    TimeLabel.Name = "TimeElapsed"
