-- [FOX] Shrek Line: Ultimate Onion Automator
-- Ubicación: StarterPlayer > StarterPlayerScripts

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local ONION_INTERVAL = 1 -- Segundos entre cada cebolla

-- ==========================================
-- 1. ESTADO Y REFERENCIAS
-- ==========================================
local Stats = {
    OnionsCollected = 0,
    StartTime = tick(),
    LastUpdate = tick()
}

-- Referencias a las GUIs (se encontrarán dinámicamente)
local playerOnionLabel = nil
local doorLabels = {} -- Tabla para almacenar referencias a los contadores de puertas

-- ==========================================
-- 2. BÚSQUEDA INTELIGENTE DE ELEMENTOS
-- ==========================================
local function findGuiElements()
    -- 1. Buscar el contador principal del jugador
    local pGui = player:FindFirstChild("PlayerGui")
    if pGui then
        local success, result = pcall(function()
            return pGui:WaitForChild("gui"):WaitForChild("Main"):WaitForChild("Onions"):WaitForChild("Onions", 5)
        end)
        if success and result then
            playerOnionLabel = result
            print("[🧅 FOX] Contador principal encontrado:", playerOnionLabel:GetFullName())
        else
            warn("[🧅 FOX] No se pudo encontrar el contador principal del jugador.")
        end
    end
    
    -- 2. Buscar todos los contadores de puertas en Workspace
    local lockedDoors = workspace:FindFirstChild("LockedDoors")
    if lockedDoors then
        for _, doorFolder in ipairs(lockedDoors:GetChildren()) do
            if doorFolder:IsA("Folder") or doorFolder:IsA("Model") then
                local surfaceGui = doorFolder:FindFirstChildWhichIsA("SurfaceGui")
                if surfaceGui then
                    local frame = surfaceGui:FindFirstChild("Frame")
                    if frame then
                        local countLabel = frame:FindFirstChild("Count")
                        if countLabel and countLabel:IsA("TextLabel") then
                            table.insert(doorLabels, {
                                folder = doorFolder,
                                label = countLabel,
                                current = tonumber(countLabel.Text) or 0
                            })
                            print("[🚪 FOX] Contador de puerta encontrado:", doorFolder.Name, "| Ruta:", countLabel:GetFullName())
                        end
                    end
                end
            end
        end
    end
end

-- Ejecutar búsqueda al inicio
task.spawn(findGuiElements)

-- ==========================================
-- 3. CREACIÓN DE GUI DE RESULTADOS MEJORADA
-- ==========================================
local function CreateResultsGUI()
