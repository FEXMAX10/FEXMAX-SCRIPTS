-- ==========================================
-- 7. APLICAR VALORES (AHORA MODIFICA EL VALUE REAL)
-- ==========================================
local function pushToGame()
    local v = tostring(Stats.Onions)
    local mult = calculateMultiplier(Stats.Onions)
    local multText = formatMultiplier(mult)
    
    -- GUI cebollas
    if gameOnionLabel then
        pcall(function() gameOnionLabel.Text = v end)
    end
    
    -- GUI dinero
    if moneyLabel then
        pcall(function() moneyLabel.Text = formatMoney(baseMoney) end)
    end
    
    -- ==========================================
    -- VALUE REAL DEL DINERO (esto es lo que el juego usa)
    -- ==========================================
    if moneyValue then
        pcall(function()
            if moneyValue:IsA("IntValue") then
                moneyValue.Value = baseMoney
            elseif moneyValue:IsA("NumberValue") then
                moneyValue.Value = baseMoney
            end
        end)
    end
    
    -- GUI multiplicador
    if multiplierLabel then
        pcall(function() multiplierLabel.Text = multText end)
    end
    
    -- Head Tags
    for _, lbl in ipairs(headTagLabels) do
        if lbl and lbl.Parent then
            pcall(function() lbl.Text = v end)
        end
    end
    
    -- Remote al servidor
    if onionRemote then
        pcall(function()
            if onionRemote:IsA("RemoteEvent") then
                onionRemote:FireServer(Stats.Onions)
            elseif onionRemote:IsA("RemoteFunction") then
                onionRemote:InvokeServer(Stats.Onions)
            end
        end)
    end
end

