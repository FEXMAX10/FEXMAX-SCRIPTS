-- ==========================================
-- 2. GUARDADO / CARGA
-- ==========================================
local hasFileAPI = (type(writefile) == "function") and (type(readfile) == "function")

local function saveData()
    if not hasFileAPI then return end
    pcall(function()
        writefile(SAVE_FILE, HttpService:JSONEncode({ 
            onions = Stats.Onions, 
            baseMoney = baseMoney 
        }))
    end)
end

local function loadData()
    if not hasFileAPI then return end
    local ok, content = pcall(function()
        if isfile and isfile(SAVE_FILE) then return readfile(SAVE_FILE) end
    end)
    if ok and content and content ~= "" then
        local pok, data = pcall(function() return HttpService:JSONDecode(content) end)
        if pok and data then
            if type(data.onions) == "number" then Stats.Onions = data.onions end
            if type(data.baseMoney) == "number" then baseMoney = data.baseMoney end
        end
    end
end

-- ==========================================
-- 3. CALCULAR MULTIPLICADOR
-- ==========================================
local function calculateMultiplier(onions)
    return 1 + math.floor(onions / 10)
end

local function formatMultiplier(mult)
    return string.format("%.2fx", mult)
end

-- ==========================================
-- 4. FORMATEAR DINERO
-- ==========================================
local function formatMoney(amount)
    if amount >= 1000000 then
        return "$" .. string.format("%.2fM", amount / 1000000)
    elseif amount >= 1000 then
        return "$" .. string.format("%.2fk", amount / 1000)
    else
        return "$" .. tostring(math.floor(amount))
    end
end

