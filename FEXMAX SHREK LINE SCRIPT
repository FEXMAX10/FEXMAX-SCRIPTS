-- ==========================================
-- 9. BUCLE PRINCIPAL (9999 × MULTIPLICADOR CADA SEGUNDO)
-- ==========================================
RunService.Heartbeat:Connect(function()
    local now = tick()

    if TimeLbl then
        local e = math.floor(now - Stats.StartTime)
        TimeLbl.Text = string.format("Sesión: %dm %ds", math.floor(e/60), e%60)
    end

    pushToGame()

    if now - Stats.LastUpdate >= ONION_INTERVAL then
        Stats.Onions += 1
        Stats.LastUpdate = now

        local mult = calculateMultiplier(Stats.Onions)
        local earnings = 9999 * mult  -- 9999 × multiplicador
        
        baseMoney = baseMoney + earnings
        
        if TotalLbl then
            TotalLbl.Text = "Cebollas: " .. Stats.Onions
            local fl = TweenService:Create(TotalLbl, TweenInfo.new(0.15), {TextColor3 = Color3.fromRGB(76,175,80)})
            fl:Play()
            task.delay(0.15, function()
                if TotalLbl and TotalLbl.Parent then
                    TweenService:Create(TotalLbl, TweenInfo.new(0.3), {TextColor3 = Color3.fromRGB(255,255,255)}):Play()
                end
            end)
        end
        
        if MoneyLbl then
            MoneyLbl.Text = "Dinero: " .. formatMoney(baseMoney)
        end
        
        if MultLbl then
            MultLbl.Text = "Multiplicador: " .. formatMultiplier(mult)
        end

        if now - Stats.LastSave >= SAVE_EVERY then
            Stats.LastSave = now
            saveData()
        end
    end
end)

